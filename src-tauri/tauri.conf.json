{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeepMeAwake",
  "version": "../package.json",
  "identifier": "dev.bajpai.keepmeawake",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self'",
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "KeepMeAwake",
        "width": 380,
        "height": 600,
        "minWidth": 340,
        "minHeight": 520,
        "maxWidth": 520,
        "maxHeight": 820,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "skipTaskbar": false,
        "zoomHotkeysEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Keep your laptop awake and your presence active.",
    "longDescription": "KeepMeAwake keeps your Windows laptop from sleeping and, optionally, keeps chat apps like Slack and Teams from marking you away. It uses the Windows power request API instead of fake keystrokes, lives in the tray, and stays tiny.",
    "publisher": "Akshay Bajpai",
    "copyright": "Copyright (c) 2026 Akshay Bajpai",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": { "language": "en-US" },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  },
  "plugins": {}
}
