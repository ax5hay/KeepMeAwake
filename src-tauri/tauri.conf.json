{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeepMeAwake",
  "version": "../package.json",
  "identifier": "dev.bajpai.keepmeawake",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self'",
      "capabilities": ["default"]
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Keep me awake",
        "width": 380,
        "height": 600,
        "minWidth": 340,
        "minHeight": 520,
        "maxWidth": 520,
        "maxHeight": 820,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "skipTaskbar": false,
        "zoomHotkeysEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "category": "Utility",
    "shortDescription": "Keep your laptop awake while you need it.",
    "longDescription": "Keep me awake holds a Windows power request or a macOS power assertion, the same mechanism a video player uses, instead of faking keystrokes. Timed sessions, a schedule, battery rules, a tray icon, and a window that gets out of the way. Nothing is typed and nothing moves.",
    "publisher": "Akshay Bajpai",
    "homepage": "https://akshaybajpai.com",
    "copyright": "Copyright (c) 2026 Akshay Bajpai",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "wix": { "language": "en-US" },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "entitlements": null,
      "dmg": {
        "background": "../design/dmg-background.png",
        "windowSize": { "width": 540, "height": 380 },
        "appPosition": { "x": 150, "y": 150 },
        "applicationFolderPosition": { "x": 390, "y": 150 }
      }
    }
  },
  "plugins": {}
}
