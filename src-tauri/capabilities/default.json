{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the single main window. Keep this list minimal: the UI only needs to drag/minimise/close itself, listen to engine events, call our own commands, and toggle autostart.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-is-focused",
    "core:window:allow-theme",
    "autostart:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/BuiltByBajpai/**" },
        { "url": "https://akshaybajpai.com/**" }
      ]
    }
  ]
}
