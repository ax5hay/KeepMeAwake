#!/usr/bin/env sh
# Enforce Conventional Commits: type(scope)?: subject
msg="$(head -n1 "$1")"
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9/-]+\))?!?: .{1,72}$'
if ! printf '%s' "$msg" | grep -Eq "$pattern"; then
  echo "commit-msg: subject must follow Conventional Commits, e.g. 'feat(tray): add duration submenu'"
  echo "  got: $msg"
  exit 1
fi
